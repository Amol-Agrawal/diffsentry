# LLM
REVIEW_PROVIDER=gemini
REVIEW_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=

# GitHub: either a token (CLI / single repo) ...
GITHUB_TOKEN=
# ... or a GitHub App (webhook service)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Protect /dashboard when deployed
DASHBOARD_TOKEN=

# Local testing only
ALLOW_UNSIGNED_WEBHOOKS=0
LOG_LEVEL=INFO
